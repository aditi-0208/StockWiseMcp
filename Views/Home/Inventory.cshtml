@model StockWiseMcp.Models.InventoryOverviewViewModel
@{
    ViewData["Title"] = "Inventory";
    var usd = System.Globalization.CultureInfo.GetCultureInfo("en-US");
}

<h1 class="h3">Inventory overview</h1>
<p class="text-muted">Synthetic data. Values are at retail price (unit price &times; quantity in stock). Low stock means quantity is at or below the reorder level.</p>

<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3"><div class="stat"><div class="stat-value">@Model.Summary.ProductCount</div><div class="stat-label">Products</div></div></div>
    <div class="col-6 col-lg-3"><div class="stat"><div class="stat-value">@Model.Summary.TotalUnits</div><div class="stat-label">Units in stock</div></div></div>
    <div class="col-6 col-lg-3"><div class="stat"><div class="stat-value">@Model.Summary.TotalRetailInventoryValue.ToString("C2", usd)</div><div class="stat-label">Retail value</div></div></div>
    <div class="col-6 col-lg-3"><div class="stat"><div class="stat-value">@Model.Summary.LowStockCount <small>(@Model.Summary.OutOfStockCount out)</small></div><div class="stat-label">Low stock</div></div></div>
</div>

<h2 class="h5">Needs reordering</h2>
<div class="table-responsive mb-4">
    <table class="table table-sm align-middle">
        <caption class="visually-hidden">Products at or below their reorder level, most urgent first</caption>
        <thead><tr><th scope="col">SKU</th><th scope="col">Product</th><th scope="col">Category</th><th scope="col" class="text-end">In stock</th><th scope="col" class="text-end">Reorder level</th><th scope="col">Supplier</th><th scope="col" class="text-end">Lead time</th></tr></thead>
        <tbody>
            @foreach (var p in Model.LowStock)
            {
                <tr>
                    <td>@p.Sku</td>
                    <td>@p.ProductName</td>
                    <td>@p.Category</td>
                    <td class="text-end">
                        @if (p.QuantityInStock == 0)
                        {
                            <span class="badge text-bg-danger">Out of stock</span>
                        }
                        else
                        {
                            @p.QuantityInStock
                        }
                    </td>
                    <td class="text-end">@p.ReorderLevel</td>
                    <td>@p.Supplier.SupplierName</td>
                    <td class="text-end">@p.Supplier.LeadTimeDays days</td>
                </tr>
            }
        </tbody>
    </table>
</div>

<h2 class="h5">Top 5 products by value</h2>
<div class="table-responsive">
    <table class="table table-sm align-middle">
        <caption class="visually-hidden">The five products with the highest retail value in stock</caption>
        <thead><tr><th scope="col">SKU</th><th scope="col">Product</th><th scope="col" class="text-end">Quantity</th><th scope="col" class="text-end">Unit price</th><th scope="col" class="text-end">Value</th></tr></thead>
        <tbody>
            @foreach (var p in Model.TopByValue)
            {
                <tr>
                    <td>@p.Sku</td>
                    <td>@p.ProductName</td>
                    <td class="text-end">@p.QuantityInStock</td>
                    <td class="text-end">@p.UnitPrice.ToString("C2", usd)</td>
                    <td class="text-end">@p.RetailInventoryValue.ToString("C2", usd)</td>
                </tr>
            }
        </tbody>
    </table>
</div>
