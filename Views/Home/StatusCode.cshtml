@model StockWiseMcp.Models.StatusCodeViewModel
@{
    ViewData["Title"] = Model.Code + " " + Model.Title;
}

<section class="error-page">
    <p class="error-code">@Model.Code</p>
    <h1 class="h3">@Model.Title</h1>
    <p class="text-muted">@Model.Message</p>
    <div class="error-actions">
        <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Go to home</a>
        <a class="btn btn-outline-primary" asp-controller="Home" asp-action="Chat">Open the chat</a>
    </div>
</section>
