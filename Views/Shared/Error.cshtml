@model ErrorViewModel
@{
    ViewData["Title"] = "Something went wrong";
}

<section class="error-page">
    <p class="error-code">Error</p>
    <h1 class="h3">Something went wrong</h1>
    <p class="text-muted">The app ran into a problem handling that request. Please try again. No inventory data was changed.</p>
    <div class="error-actions">
        <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Go to home</a>
        <a class="btn btn-outline-primary" asp-controller="Home" asp-action="Chat">Open the chat</a>
    </div>

    @if (Model.ShowRequestId)
    {
        <p class="text-muted mt-3"><small>Reference ID: <code>@Model.RequestId</code></small></p>
    }
</section>
